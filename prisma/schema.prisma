generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tabelas do NextAuth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  
  // O campo obrigatório que o GitHub passou a enviar:
  refresh_token_expires_in Int?    

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  
  // NOVO: Guarda o horário do lembrete global (ex: "20:00")
  globalReminder String?  

  accounts      Account[]
  sessions      Session[]
  habits        Habit[]

  subscriptions PushSubscription[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Nossas tabelas de Hábitos atualizadas
model Habit {
  id            String     @id @default(cuid())
  title         String
  createdAt     DateTime   @default(now())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]
  streak        Int        @default(0)

  // NOVO: Guarda múltiplos horários separados por vírgula (ex: "10:00,13:00,16:00")
  reminderTimes String?    

  // --- NOVOS CAMPOS ADICIONADOS ---
  isActive      Boolean    @default(true)
  daysOfWeek    String?    @default("0,1,2,3,4,5,6") // 0=Dom, 1=Seg, 2=Ter... 6=Sab
}

model HabitLog {
  id      String   @id @default(uuid())
  habitId String
  date    DateTime @db.Date

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date]) 
  @@map("habit_logs")
}

// NOVA TABELA: Guarda as inscrições de notificação (dispositivos do usuário)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Dados exigidos pela Web Push API
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  
  createdAt DateTime @default(now())
}